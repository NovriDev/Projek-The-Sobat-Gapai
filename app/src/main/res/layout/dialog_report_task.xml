<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="#262627"
    android:orientation="vertical">
    
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_alignParentEnd="true"
            android:id="@+id/cancel_button_dialog"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_cancel"
            app:tint="#FF3939" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Laporkan"
        android:background="@drawable/rounded_corner_field"
        android:textColor="@color/white"
        android:backgroundTint="#FF0000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_centerInParent="true"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#515151"
        android:background="@drawable/rounded_corner_field" >
    <EditText
        android:id="@+id/etReportTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_semibold"
        android:text="Laporkan Jawaban"
        android:textSize="20sp"
        android:background="@drawable/rounded_corner_field"
        android:backgroundTint="#515151"
        android:textColor="@color/white"
        android:textAlignment="center" />
    </LinearLayout>

    <TextView
        android:layout_marginTop="20dp"
        android:id="@+id/tvReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih alasan laporan:"
        android:paddingTop="8dp"
        android:textColor="@color/white"
        android:paddingBottom="4dp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioGroupReasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbReason1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Jawaban tidak sesuai materi" />


        <RadioButton
            android:id="@+id/rbReason3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Pelanggaran aturan" />

        <RadioButton
            android:id="@+id/rbReason4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:fontFamily="@font/montserrat_semibold"
            android:text="Username tidak pantas" />
    </RadioGroup>

    <Button
        android:id="@+id/btnSubmitReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_semibold"
        android:text="Laporkan"
        android:layout_marginTop="20dp"
        android:background="@drawable/button_gradient"
        android:textColor="@android:color/white" />

</LinearLayout>
