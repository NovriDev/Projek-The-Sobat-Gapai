<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/toolbar_dark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="35dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_marginTop="50dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_bold"
                android:text="Hai,\nSelamat Datang\nKembali"
            />
            <ImageView
                android:id="@+id/form_ajuan"
                android:layout_marginTop="50dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_admin"
                app:tint="@color/white" />
            />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:fontFamily="@font/montserrat_light"
            android:layout_marginTop="8dp"
            android:textSize="20sp"
            android:text="Login untuk \nmasuk ke aplikasi"
        />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8FFFFFF"
            android:text="Email"
            android:textSize="20sp"
            android:layout_marginTop="45dp"
            android:fontFamily="@font/montserrat_bold"
            />
        <RelativeLayout
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_corner_field">
            <EditText
                android:id="@+id/email"
                android:drawableLeft="@drawable/ic_email"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:paddingLeft="10dp"
                android:hint="Masukkan Email"
                android:drawablePadding="8dp"
                android:inputType="textEmailAddress"
                android:textColor="@color/white"
                android:singleLine="true"
                android:textColorHint="@color/white"
                android:textSize="18dp"
                android:backgroundTint="#262627"
                android:background="@drawable/rounded_rectangle_field"
                android:fontFamily="@font/montserrat_light"
                />
        </RelativeLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8FFFFFF"
            android:text="Password"
            android:textSize="20sp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/montserrat_bold"
            />
        <RelativeLayout
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_corner_field">
        <EditText
            android:id="@+id/password"
            android:drawableLeft="@drawable/ic_lock"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:paddingLeft="10dp"
            android:textSize="18sp"
            android:inputType="textPassword"
            android:hint="Masukkan Password"
            android:drawablePadding="8dp"
            android:singleLine="true"
            android:maxLength="20"
            android:textColorHint="@color/white"
            android:textColor="@color/white"
            android:backgroundTint="#262627"
            android:background="@drawable/rounded_rectangle_field"
            android:fontFamily="@font/montserrat_light"
            />
            <ImageView
                android:id="@+id/show_password"
                android:layout_marginTop="5dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="8dp"
                android:layout_alignParentRight="true"
                android:src="@drawable/ic_eye_off"/>
        </RelativeLayout>
        <Button
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="35dp"
            android:text="Login"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:fontFamily="@font/montserrat_bold"
            android:background="@drawable/button_gradient"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginBottom="18dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum Punya Akun? "
            android:fontFamily="@font/montserrat_light"
            android:textColor="@color/white"/>
        <TextView
            android:id="@+id/register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:fontFamily="@font/montserrat_bold"
            android:text="Daftar Disini"/>
    </LinearLayout>
</RelativeLayout>