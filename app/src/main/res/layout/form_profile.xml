<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/LL1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="8dp">
        <ImageView
            android:id="@+id/edit_profile_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_edit_profile"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LL2"
        android:layout_below="@+id/LL1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:id="@+id/pp_user"
            android:layout_width="85dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_profile"/>
        <TextView
            android:id="@+id/level_user"
            android:layout_marginTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level 0"
            android:padding="8dp"
            android:background="@drawable/rounded_corner"
            android:fontFamily="@font/montserrat_bold"
            android:textSize="15sp"
            android:textColor="@color/white"/>
        <TextView
            android:id="@+id/username"
            android:layout_marginTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USERNAME"
            android:fontFamily="@font/montserrat_semibold"
            android:textSize="18sp"
            android:textColor="@color/white"/>
        <TextView
            android:id="@+id/created_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bergabung pada"
            android:fontFamily="@font/montserrat_light"
            android:textSize="12sp"
            android:textColor="@color/white"/>
    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="50dp"
        android:layout_below="@id/LL2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="#CC2B2B2B"
        android:background="@drawable/rounded_corner"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saya"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/btn_balance"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/ic_balance"
            android:drawableRight="@drawable/ic_right_btn"
            android:backgroundTint="#393939"
            android:drawableTint="#80FFFFFF"
            android:layout_width="match_parent"
            android:text="Saldo"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/white"
            android:textAlignment="textStart"
            android:drawablePadding="20dp"
            android:layout_height="60dp"/>
        <Button
            android:id="@+id/btn_record"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/ic_history"
            android:drawableRight="@drawable/ic_right_btn"
            android:backgroundTint="#393939"
            android:drawableTint="#80FFFFFF"
            android:layout_width="match_parent"
            android:text="Rekor Saya"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/white"
            android:textAlignment="textStart"
            android:drawablePadding="20dp"
            android:layout_height="60dp"/>
        <Button
            android:id="@+id/btn_my_tugas"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/ic_tugas"
            android:drawableRight="@drawable/ic_right_btn"
            android:backgroundTint="#393939"
            android:drawableTint="#80FFFFFF"
            android:layout_width="match_parent"
            android:text="Tugas Saya"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/white"
            android:textAlignment="textStart"
            android:drawablePadding="20dp"
            android:layout_height="60dp"/>
        <Button
            android:id="@+id/btn_friend_followers"
            android:layout_marginTop="8dp"
            android:drawableLeft="@drawable/ic_friend"
            android:drawableRight="@drawable/ic_right_btn"
            android:backgroundTint="#393939"
            android:drawableTint="#80FFFFFF"
            android:layout_width="match_parent"
            android:text="Teman"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/white"
            android:textAlignment="textStart"
            android:drawablePadding="20dp"
            android:layout_height="60dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Umum"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/btn_ttg_app"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/ic_question"
            android:drawableRight="@drawable/ic_right_btn"
            android:backgroundTint="#393939"
            android:drawableTint="#80FFFFFF"
            android:layout_width="match_parent"
            android:text="Tentang 'The Sobat Gapai' "
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/white"
            android:textAlignment="textStart"
            android:drawablePadding="20dp"
            android:layout_height="60dp"/>
        <Button
            android:id="@+id/btn_logout"
            android:layout_marginTop="8dp"
            android:drawableLeft="@drawable/ic_logout"
            android:drawableRight="@drawable/ic_right_btn"
            android:backgroundTint="#393939"
            android:drawableTint="#80FFFFFF"
            android:layout_width="match_parent"
            android:text="Logout"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/white"
            android:textAlignment="textStart"
            android:drawablePadding="20dp"
            android:layout_height="60dp"/>
    </LinearLayout>
        <com.github.ybq.android.spinkit.SpinKitView
            android:id="@+id/spinner"
            style="@style/SpinKitView.Small.FoldingCube"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_centerInParent="true"
            android:padding="40dp"
            android:visibility="gone"
            android:background="@drawable/button_gradient"
            android:layout_gravity="center"
            app:SpinKit_Color="@color/white" />
    </RelativeLayout>
</ScrollView>
