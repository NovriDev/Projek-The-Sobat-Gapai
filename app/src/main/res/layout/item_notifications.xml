<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    tools:context=".Fragment.NotifikasiFragment">

    <LinearLayout
        android:backgroundTint="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Gambar atau avatar pengguna -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:padding="8dp"
            android:src="@drawable/ic_notification_2"
            app:tint="@color/black" />

        <!-- Kolom teks untuk deskripsi notifikasi -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <!-- Nama pengguna yang mengirim notifikasi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifikasi"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:fontFamily="@font/montserrat_semibold"
                android:textStyle="bold"/>

            <!-- Pesan notifikasi -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USERNAME"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginEnd="2dp"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/pesan_notifikasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pesan "
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp"/>
        </LinearLayout>
            <!-- Waktu notifikasi -->
            <TextView
                android:id="@+id/notificationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 menit yang lalu"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"/>

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
